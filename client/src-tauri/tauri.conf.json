{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "client",
  "version": "0.1.0",
  "identifier": "com.lumineria.client",
  "build": {
    "beforeDevCommand": "cargo build -p agent && cp ../target/debug/lumineria-agent src-tauri/lumineria-agent-x86_64-unknown-linux-gnu",
    "beforeBuildCommand": "cargo build -p agent --release && cp ../target/release/lumineria-agent src-tauri/lumineria-agent-x86_64-unknown-linux-gnu",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lumineria Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "lumineria-agent"
    ]
  }
}